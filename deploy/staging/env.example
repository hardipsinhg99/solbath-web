# Templates for the three env files that live OUTSIDE the repo, in
# /opt/solbath-staging/{db,cms,web}.env (mode 600). No real values here.

# ---- db.env ----------------------------------------------------------------
POSTGRES_DB=solbath_staging
POSTGRES_USER=solbath_staging
POSTGRES_PASSWORD=            # openssl rand -hex 24

# ---- cms.env ---------------------------------------------------------------
NODE_ENV=production
HOST=0.0.0.0
PORT=1337
PUBLIC_URL=https://test-api.solbath.com
IS_PROXIED=true
CORS_ORIGIN=https://test.solbath.com
APP_KEYS=                     # 4 x openssl rand -base64 24, comma separated
API_TOKEN_SALT=               # openssl rand -base64 24
ADMIN_JWT_SECRET=
JWT_SECRET=
TRANSFER_TOKEN_SALT=
ENCRYPTION_KEY=
DATABASE_CLIENT=postgres
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_NAME=solbath_staging
DATABASE_USERNAME=solbath_staging
DATABASE_PASSWORD=            # same as POSTGRES_PASSWORD
DATABASE_SSL=false
UPLOAD_PROVIDER=local
# Revalidation webhook goes over the internal compose network, not the internet.
FRONTEND_URL=http://web:3000
REVALIDATE_SECRET=            # openssl rand -hex 32, identical in web.env

# ---- web.env ---------------------------------------------------------------
NODE_ENV=production
STRAPI_URL=https://test-api.solbath.com
REVALIDATE_SECRET=
