{
  "kind": "collectionType",
  "collectionName": "inspiration_posts",
  "info": {
    "singularName": "inspiration-post",
    "pluralName": "inspiration-posts",
    "displayName": "Inspiration Post",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "title": {
      "type": "string",
      "required": true
    },
    "room": {
      "type": "enumeration",
      "enum": ["Bathroom", "Kitchen", "Guide", "Outdoor"]
    },
    "excerpt": {
      "type": "text",
      "required": true
    },
    "readTime": {
      "type": "string"
    },
    "coverImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "tone": {
      "type": "enumeration",
      "enum": ["bath", "tile", "hardware", "kitchen", "lifestyle", "neutral", "dark"]
    },
    "body": {
      "type": "richtext"
    },
    "relatedProducts": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::product.product"
    }
  }
}
