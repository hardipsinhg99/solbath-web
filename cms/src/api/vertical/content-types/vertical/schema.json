{
  "kind": "collectionType",
  "collectionName": "verticals",
  "info": {
    "singularName": "vertical",
    "pluralName": "verticals",
    "displayName": "Vertical",
    "description": "The top-level verticals — hero copy for vertical landing pages."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "key": {
      "type": "enumeration",
      "enum": ["bathroom-accessories", "ceramic-tiles", "hardware", "kitchen"],
      "required": true,
      "unique": true
    },
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "tagline": {
      "type": "string",
      "required": true
    },
    "heroDescription": {
      "type": "text"
    },
    "tone": {
      "type": "enumeration",
      "enum": ["bath", "tile", "hardware", "kitchen"]
    },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "popularProducts": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::product.product"
    },
    "sortOrder": {
      "type": "integer",
      "default": 0
    },
    "isActive": {
      "type": "boolean",
      "default": true
    },
    "seoTitle": {
      "type": "string"
    },
    "seoDescription": {
      "type": "text"
    }
  }
}
