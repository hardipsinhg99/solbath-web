# Server
HOST=0.0.0.0
PORT=1337

# Secrets — generate real values for every deploy, never reuse these across
# environments. `npx strapi generate` or any random base64 string works for
# the *_SALT/*_SECRET/ENCRYPTION_KEY values; APP_KEYS wants 2-4 comma
# separated random strings.
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
JWT_SECRET=
TRANSFER_TOKEN_SALT=
ENCRYPTION_KEY=

# Database (docker-compose.yml at the repo root runs Postgres on :5433 for
# local dev — use a managed Postgres instance in production instead)
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5433
DATABASE_NAME=solbath_cms
DATABASE_USERNAME=solbath
DATABASE_PASSWORD=solbath
DATABASE_SSL=false
DATABASE_FILENAME=

# Media storage. Defaults to 'local' (writes to this server's disk — the
# right choice for a single-VPS deploy, e.g. Hostinger). Set to 'aws-s3' to
# use S3-compatible object storage instead (AWS S3, or MinIO locally via
# docker-compose.yml) — the MINIO_* vars below only matter when you do.
UPLOAD_PROVIDER=local

# MINIO_* — only read when UPLOAD_PROVIDER=aws-s3
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_BUCKET=solbath-media
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_PUBLIC_URL=http://127.0.0.1:9000
# Defaults to us-east-1, which is wrong if your bucket lives in a different
# region. See DEPLOYMENT.md.
MINIO_REGION=us-east-1

# Next.js revalidation webhook — must match the frontend's STRAPI_URL
# host/port and REVALIDATE_SECRET exactly (see ../.env.example).
FRONTEND_URL=http://localhost:3000
REVALIDATE_SECRET=
